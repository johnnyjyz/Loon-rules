#!name = Taobao App Overseas Test (Loon 3.5.0)
#!desc = Compatible with public Loon 3.5.0. Tests Taobao app overseas restriction by normalizing thw=us to thw=cn, clearing trade-acs direct IP mappings from AMDC, and patching explicit overseas restriction signals in item-detail responses.
#!author = ChatGPT
#!system = iOS,iPadOS
#!loon_version = 3.5.0(969)
#!tag = Taobao,Diagnostic
#!type = normal

[Argument]
normalize_region = switch,true,tag=地区 Cookie 测试,desc=仅在淘宝商品相关 API 请求中将 thw=us 改为 thw=cn
patch_detail = switch,true,tag=商品响应修补,desc=只修补明确的海外禁限售字段/跳转
notify = switch,true,tag=调试通知,desc=命中相关请求时发送 Loon 通知
debug = switch,true,tag=详细日志,desc=输出调试信息到 Loon 日志

[Rule]
URL-REGEX,^http:\/\/(?:amdc\.m\.taobao\.com|47\.246\.103\.(?:9|10)|59\.82\.113\.(?:10|219))\/amdc\/mobileDispatch(?:\?|$),DIRECT

[Script]

http-request ^https:\/\/(?:acs|trade-acs|h5api)\.m\.taobao\.com\/ script-path=https://raw.githubusercontent.com/johnnyjyz/Loon-rules/main/taobao_app_overseas.js,tag=Taobao region-cookie test,timeout=20,argument=[{normalize_region},{patch_detail},{notify},{debug}],enable={normalize_region}

http-response ^http:\/\/(?:amdc\.m\.taobao\.com|\d{1,3}(?:\.\d{1,3}){3})\/amdc\/mobileDispatch script-path=https://raw.githubusercontent.com/johnnyjyz/Loon-rules/main/taobao_app_overseas.js,tag=Taobao AMDC route test,requires-body=true,timeout=20,argument=[{normalize_region},{patch_detail},{notify},{debug}],enable=true

http-response ^https:\/\/(?:trade-acs|acs|h5api)\.m\.taobao\.com\/(?:gw|h5)\/(?:mtop\.taobao\.detail\.[^\/?]+|mtop\.taobao\.pcdetail\.data\.get) script-path=https://raw.githubusercontent.com/johnnyjyz/Loon-rules/main/taobao_app_overseas.js,tag=Taobao detail overseas test,requires-body=true,timeout=20,argument=[{normalize_region},{patch_detail},{notify},{debug}],enable={patch_detail}

[Mitm]
hostname = acs.m.taobao.com, trade-acs.m.taobao.com, h5api.m.taobao.com